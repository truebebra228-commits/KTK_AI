extends SceneTree
## Actual gameplay captures for respawn, landing and remote detonation.
## Run only after production is ready:
## Godot --fixed-fps 60 --path bombbound --script res://tests/effects_preview.gd
## The filmstrip samples both early and later effect phases, so an expanding
## outline cannot be hidden by a conveniently timed single screenshot.

var game: Node2D
var last_landing_impact: float = 0.0
var states: Array[Dictionary] = []


func _initialize() -> void:
	call_deferred("capture")


func _frames(count: int) -> void:
	for _i: int in count:
		await physics_frame
	await process_frame


func _landed(impact: float) -> void:
	last_landing_impact = impact


func _save(label: String) -> void:
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://previews/effects-" + label + ".png")
	states.append({
		"label": label,
		"player": [game.player.position.x, game.player.position.y],
		"sparks": game.effects.sparks.size(),
		"smoke": game.effects.smoke.size(),
		"last_landing_impact": last_landing_impact,
	})


func capture() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://previews"))
	game = load("res://scenes/main.tscn").instantiate() as Node2D
	root.add_child(game)
	await _frames(12)
	game.sound.set_enabled(false)
	game.load_room(4)
	game.toast_time = 0.0
	game.player.landed.connect(_landed)
	await _frames(12)
	# A genuine checkpoint restart creates the spawn particles.
	game.respawn(false)
	game.toast_time = 0.0
	await _frames(1)
	await _save("spawn-01")
	await _frames(5)
	await _save("spawn-06")
	await _frames(12)
	await _save("spawn-18")
	await _frames(100)
	# Real jump and collision; the landing event must be generated by physics.
	last_landing_impact = 0.0
	game.player.perform_jump(0.0)
	await _frames(5)
	var did_land: bool = false
	for _i: int in 180:
		await _frames(1)
		if game.player.is_on_floor() and last_landing_impact > 300.0:
			did_land = true
			break
	if not did_land:
		push_error("Effect preview: physical landing was not reached.")
		game.queue_free()
		quit(2)
		return
	await _save("landing-01")
	await _frames(5)
	await _save("landing-06")
	await _frames(12)
	await _save("landing-18")
	await _frames(100)
	# Place and release a real charge, let it settle, then use the game API.
	game.begin_placement()
	game.update_placement(game.player.position + Vector2(35, 8))
	if not game.commit_placement():
		push_error("Effect preview: the nearby free charge could not be placed.")
		game.queue_free()
		quit(2)
		return
	await _frames(12)
	game.detonate_bombs()
	await _frames(1)
	await _save("explosion-01")
	await _frames(5)
	await _save("explosion-06")
	await _frames(12)
	await _save("explosion-18")
	var file: FileAccess = FileAccess.open("res://previews/effects-capture.json", FileAccess.WRITE)
	file.store_string(JSON.stringify(states, "\t"))
	file.close()
	print("EFFECTS PREVIEW: actual respawn, landing (%.1f px/s), explosion; %d rendered states." % [last_landing_impact, states.size()])
	game.queue_free()
	await process_frame
	quit(0)
