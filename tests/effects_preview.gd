extends SceneTree
## Actual gameplay captures for respawn, jump, landing and remote detonation.
## Godot --fixed-fps 60 --path bombbound --script res://tests/effects_preview.gd

var game: Node2D
var last_landing_impact: float = 0.0
var states: Array[Dictionary] = []
var output_dir: String


func _initialize() -> void:
	call_deferred("capture")


func _frames(count: int) -> void:
	for _i: int in count:
		await process_frame


func _landed(impact: float) -> void:
	last_landing_impact = impact


func _save(label: String, closeup: bool = false) -> void:
	await RenderingServer.frame_post_draw
	var image: Image = root.get_texture().get_image()
	image.save_png(output_dir.path_join("effects-" + label + ".png"))
	if closeup and image.get_size() == Vector2i(1280, 720):
		var region: Rect2i = Rect2i(78, 538, 67, 74) if label == "room-1-idle" else Rect2i(536, 490, 218, 144)
		var zoom: int = 4 if label == "room-1-idle" else 3
		var detail: Image = image.get_region(region)
		detail.resize(region.size.x * zoom, region.size.y * zoom, Image.INTERPOLATE_NEAREST)
		detail.save_png(output_dir.path_join("detail-" + label + ".png"))
	states.append({
		"label": label,
		"player": [game.player.position.x, game.player.position.y],
		"sparks": game.effects.sparks.size(),
		"smoke": game.effects.smoke.size(),
		"last_landing_impact": last_landing_impact,
	})


func capture() -> void:
	output_dir = OS.get_environment("BOMB_THE_WAY_EFFECTS_PREVIEW_DIR")
	if output_dir.is_empty():
		output_dir = "res://previews"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output_dir))
	game = load("res://scenes/main.tscn").instantiate() as Node2D
	root.add_child(game)
	game._apply_fullscreen(false)
	root.size = Vector2i(1280, 720)
	game.set_process_unhandled_input(false)
	await _frames(12)
	game.sound.set_enabled(false)
	game.start_game()
	await _frames(20)
	await _save("room-1-idle", true)
	game.load_room(4)
	game.toast_time = 0.0
	game.player.landed.connect(_landed)
	await _frames(12)
	# A genuine checkpoint restart creates the spawn particles.
	game.respawn(false)
	game.toast_time = 0.0
	await _frames(1)
	await _save("spawn-01")
	await _frames(5)
	await _save("spawn-06")
	await _frames(12)
	await _save("spawn-18")
	await _frames(100)
	await _save("idle", true)
	# Real jump and collision; the landing event must be generated by physics.
	last_landing_impact = 0.0
	game.player.perform_jump(0.0)
	await _frames(1)
	await _save("jump-01", true)
	await _frames(5)
	await _save("jump-06", true)
	var did_land: bool = false
	for _i: int in 180:
		await _frames(1)
		if game.player.is_on_floor() and last_landing_impact > 300.0:
			did_land = true
			break
	if not did_land:
		push_error("Effect preview: physical landing was not reached.")
		game.queue_free()
		quit(2)
		return
	await _save("landing-01", true)
	await _frames(5)
	await _save("landing-06", true)
	await _frames(12)
	await _save("landing-18")
	await _frames(100)
	# Place and release a real charge, let it settle, then use the game API.
	game.begin_placement()
	game.update_placement(game.player.position + Vector2(35, 8))
	if not game.commit_placement():
		push_error("Effect preview: the nearby free charge could not be placed.")
		game.queue_free()
		quit(2)
		return
	await _frames(12)
	game.detonate_bombs()
	await _frames(1)
	await _save("explosion-01", true)
	await _frames(5)
	await _save("explosion-06", true)
	await _frames(12)
	await _save("explosion-18", true)
	var world: SubViewport = game.player.get_viewport() as SubViewport
	var file: FileAccess = FileAccess.open(output_dir.path_join("effects-capture.json"), FileAccess.WRITE)
	file.store_string(JSON.stringify({
		"window": [root.size.x, root.size.y],
		"world_texture": [world.size.x, world.size.y],
		"world_logical": [world.size_2d_override.x, world.size_2d_override.y],
		"states": states,
	}, "\t"))
	file.close()
	print("EFFECTS PREVIEW: %s world; actual respawn, jump, landing (%.1f px/s), explosion; %d rendered states." % [world.size, last_landing_impact, states.size()])
	game.queue_free()
	await process_frame
	quit(0)
